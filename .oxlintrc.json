{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // react / react-hooks / jsx-a11y matter to @miel/web and @miel/landing-page.
  // They are listed here, repo-wide, rather than in an `overrides` entry scoped
  // to those two packages, because oxlint resolves `categories` against the base
  // plugin set only: a plugin added inside an override contributes nothing
  // unless every one of its rules is also named there by hand. The packages with
  // no JSX in them have nothing for these rules to match, so the reach is wider
  // than the effect.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-hooks",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    // React 19 compiles JSX through the automatic runtime, so `React` does not
    // have to be in scope and no file here imports it. The rule predates that.
    "react/react-in-jsx-scope": "off",
    // Narrowed rather than turned off. `_tag` is Effect's discriminant on every
    // `Data.TaggedError` in errors.ts, so it is spelled by the library, not by
    // us; the three `_*ForTests` exports use the underscore as the warning it
    // is meant to be, and naming them here keeps that list short and visible.
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_tag",
          "_resetSyncLockForTests",
          "_resetSchedulerRegistryForTests",
          "_setCommandExecutorLayerForTests",
          "_setHostedGenerateForTests"
        ]
      }
    ],
    // The rule looks for a native control under the `<label>` and cannot see
    // through a component boundary. These three are the gousse-ui primitives
    // that render one, so a label wrapping them is associated after all.
    "jsx-a11y/label-has-associated-control": [
      "error",
      { "controlComponents": ["Checkbox", "Input", "Textarea"] }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    // Vendored gousse-ui source, exempt for the reason it is exempt from the
    // formatter: `bunx shadcn@latest add @gousse/<item>` overwrites these files
    // from upstream, so anything we change here returns as noise on the next
    // re-add. See CLAUDE.md, "Design system".
    "packages/web/src/components/ui/**",
    "packages/web/src/lib/gousse/**",
    // Regenerated by the TanStack Router plugin on every dev run and build.
    "packages/landing-page/src/routeTree.gen.ts"
  ]
}
