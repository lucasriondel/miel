{
  "name": "miel",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@miel/api --filter=@miel/web",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "sandcastle": "bun .sandcastle/main.ts",
    "sandcastle:implement": "bun .sandcastle/implement/index.ts",
    "sandcastle:implement-review": "bun .sandcastle/implement-review/index.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "drizzle-kit": "^0.30",
    "drizzle-orm": "^0.36",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postgres": "^3.4",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.4",
  "dependencies": {
    "zod": "^4.4.3"
  }
}
