DATABASE_URL=postgres://miel:miel@localhost:5435/miel
POSTGRES_PASSWORD=miel
GOG_BIN=/opt/homebrew/bin/gog
CLAUDE_BIN=claude
API_PORT=3001
WEB_PORT=3000
API_SECRET=change-me-to-a-random-string

# Local dev only: Vite reads these at build time and bakes them into the SPA bundle.
# In prod they MUST be passed as Docker build args to the @miel/web image, NOT as
# runtime env (changing them at runtime has no effect).
VITE_API_BASE=/api
VITE_API_SECRET=change-me-to-a-random-string

# --- prod only (Dokploy) ---
# Comma-separated allowlist of allowed CORS origins for the API. Example:
# WEB_ORIGIN=https://miel.gousse.cool
WEB_ORIGIN=http://localhost:3000

# gogcli on the VPS uses an encrypted on-disk keyring instead of macOS Keychain.
# Set a long random password as a Dokploy secret; tokens live in the mounted
# /home/app/.config/gogcli volume.
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=change-me-long-random-string
