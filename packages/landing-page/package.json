{
  "name": "@miel/landing-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5200 --strictPort",
    "build": "vite build && bun scripts/staticize.ts && bun scripts/verify-prerendered.ts",
    "verify": "bun scripts/verify-prerendered.ts",
    "encode-assets": "bun scripts/encode-assets.ts",
    "preview": "vite preview --port 5200 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "bun test",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "@miel/core": "workspace:*",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.7.0",
    "vite": "^8.1.3"
  }
}
