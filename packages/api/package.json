{
  "name": "@miel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "mkdir -p ../../logs && bun run --env-file=../../.env --watch src/index.ts 2>&1 | tee ../../logs/api.log",
    "build": "tsc",
    "start": "bun run --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "test": "bash ./scripts/test-with-db.sh",
    "lint": "oxlint -c ../../.oxlintrc.json ."
  },
  "dependencies": {
    "@miel/core": "workspace:*",
    "hono": "^4.6.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
